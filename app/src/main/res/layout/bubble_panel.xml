<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/panel_bg"
    android:padding="20dp"
    android:elevation="8dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Volumen"
            android:textColor="#1A1A1C"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/panel_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="#433B82"
            android:textSize="18sp" />
    </RelativeLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Multimedia" android:textColor="#2D2D35" android:textSize="13sp" />
    <SeekBar android:id="@+id/sb_music" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="Llamada" android:textColor="#2D2D35" android:textSize="13sp" />
    <SeekBar android:id="@+id/sb_ring" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="Notificación" android:textColor="#2D2D35" android:textSize="13sp" />
    <SeekBar android:id="@+id/sb_notif" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="Alarma" android:textColor="#2D2D35" android:textSize="13sp" />
    <SeekBar android:id="@+id/sb_alarm" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
